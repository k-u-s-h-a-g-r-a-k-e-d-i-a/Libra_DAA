{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LibraDAA C",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-D_POSIX_C_SOURCE=200809L",
        "-D__USE_MINGW_ANSI_STDIO=1",
        "src/main.c",
        "src/library.c",
        "src/algorithms.c",
        "src/workbench.c",
        "src/evidence.c",
        "src/tests.c",
        "-lm",
        "-o",
        "libradaa"
      ],
      "windows": {
        "args": [
          "-std=c11",
          "-g",
          "-O0",
          "-Wall",
          "-Wextra",
          "-Wpedantic",
          "-D__USE_MINGW_ANSI_STDIO=1",
          "src/main.c",
          "src/library.c",
          "src/algorithms.c",
          "src/workbench.c",
          "src/evidence.c",
          "src/tests.c",
          "-lm",
          "-o",
          "libradaa.exe"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run LibraDAA C",
      "type": "process",
      "command": "${workspaceFolder}/libradaa",
      "windows": {
        "command": "${workspaceFolder}/libradaa.exe"
      },
      "dependsOn": "Build LibraDAA C",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
